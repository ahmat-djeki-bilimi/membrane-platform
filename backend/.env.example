# Copier en .env et adapter. Toutes les valeurs ont un défaut pour le développement.

# Base de données (SQLite par défaut ; PostgreSQL en production)
# DATABASE_URL=postgresql+psycopg://memprot:memprot@localhost:5432/memprotscope

# File de calculs (SQLite par défaut ; Redis en production)
# QUEUE_URL=redis://localhost:6379/0

# Worker intégré à l'API (true en développement, false si un worker séparé tourne)
EMBEDDED_WORKER=true
WORKER_THREADS=2

# Origines autorisées (adresse du site)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# DeepTMHMM via BioLib
DEEPTMHMM_ENABLED=true

# Migrations automatiques au démarrage (désactiver si `alembic upgrade head` est lancé à part)
AUTO_MIGRATE=true

# Durée d'une session de connexion (jours)
SESSION_DAYS=30
